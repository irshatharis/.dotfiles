# Dotfiles secrets template. Copy to `.env` and fill in real values:
#   cp .env.example .env && chmod 600 .env
# `.env` is gitignored. It is sourced by .zshrc so tools can read these vars,
# and read directly by the usage-alerts watcher (which launchd starts without
# your shell environment).

# Telegram bot used for usage-limit reset alerts (`usage-alerts test`).
# The bot itself is @irshad_macos_bot; get the token from @BotFather.
export IRSHAD_MACOS_BOT_TELEGRAM_API_KEY=

# Destination chat for those alerts. Find it with `usage-alerts discover`
# (send the bot a message first).
export IRSHAD_MACOS_BOT_TELEGRAM_CHAT_ID=
