{
  "permissions": {
    "deny": [
      "EnterWorktree",
      "ExitWorktree",
      "DesignSync",
      "NotebookEdit",
      "ReportFindings",
      "ScheduleWakeup",
      "RemoteTrigger",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterPlanMode",
      "ExitPlanMode",
      "Workflow",
      "ShareOnboardingGuide",
      "SendFeedback"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "enabledPlugins": {
    "pstack@cursor-plugins": true
  },
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 400000,
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "idleCompaction": false,
  "autoContinueAtUsageLimit": true
}
